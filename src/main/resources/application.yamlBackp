server:
  port: 8081

spring:
  application:
    name: API-GATEWAY

  cloud:
    gateway:
      routes:
        - id: account-service
          uri: lb://ACCOUNT-SERVICE
          predicates:
            - Path=/api/v1/accountdetails/**

        - id: card-service
          uri: lb://CARD-SERVICE
          predicates:
            - Path=/api/cards/**

        - id: loan-service
          uri: lb://loanservice
          predicates:
            - Path=/api/loan/**

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka